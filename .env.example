# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Server only (used by /api/ocr). Get it at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Optional: override the model used for photo transcription
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Browser (safe to expose; protected by Supabase row-level security)
# Supabase → Project Settings → API. Leave empty to run in local-only mode
# (data stays in this browser; good for development, NOT for teacher + student on two computers).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
